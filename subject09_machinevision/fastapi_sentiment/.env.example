# 이 파일을 .env로 복사한 뒤 값을 채웁니다:  cp .env.example .env
# .env는 GitHub에 올리지 않습니다.

# PostgreSQL (compose.yaml과 DATABASE_URL이 같은 값을 써야 함)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=postgresql+psycopg://<사용자>:<비밀번호>@127.0.0.1:5433/<DB이름>

# Redis: /1 캐시, /2 Celery Broker, /3 Celery 결과
REDIS_CACHE_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
