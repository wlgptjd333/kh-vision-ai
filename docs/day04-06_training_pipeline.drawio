eometry"/></mxCell><mxCell id="c40" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;html=1;fillColor=#ebf7f0;strokeColor=#e5e7eb;" vertex="1" parent="1"><mxGeometry x="864" y="136" width="368" height="876" as="geometry"/></mxCell><mxCell id="c41" value="" style="rounded=1;arcSize=13;absoluteArcSize=1;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="865" y="196" width="366" height="815" as="geometry"/></mxCell><mxCell id="c42" value="" style="html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="865" y="196" width="366" height="24" as="geometry"/></mxCell><mxCell id="c43" value="" style="html=1;fillColor=#e5e7eb;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="865" y="195" width="366" height="1" as="geometry"/></mxCell><mxCell id="c44" value="&lt;span style=&quot;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:13px;font-weight:800;color:#fff;&quot;&gt;3&lt;/span&gt;" style="ellipse;html=1;fillColor=#15803d;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="884" y="153" width="26" height="26" as="geometry"/></mxCell><mxCell id="c45" value="&lt;span style=&quot;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:18px;font-weight:800;color:#111827;&quot;&gt;Feature · 학습&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="150" width="200" height="32" as="geometry"/></mxCell><mxCell id="c46" value="&lt;span style=&quot;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:12px;color:#4b5563;&quot;&gt;6일차&lt;/span&gt;" style="text;html=1;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1112" y="150" width="100" height="32" as="geometry"/></mxCell><mxCell id="c47" value="" style="rounded=1;arcSize=14;absoluteArcSize=1;html=1;fillColor=#fdf0e8;strokeColor=#e5e7eb;" vertex="1" parent="1"><mxGeometry x="1272" y="136" width="368" height="876" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;arcSize=13;absoluteArcSize=1;html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1273" y="196" width="366" height="815" as="geometry"/></mxCell><mxCell id="c49" value="" style="html=1;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1273" y="196" width="366" height="24" as="geometry"/></mxCell><mxCell id="c50" value="" style="html=1;fillColor=#e5e7eb;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1273" y="195" width="366" height="1" as="geometry"/></mxCell><mxCell id="c51" value="&lt;span style=&quot;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:13px;font-weight:800;color:#fff;&quot;&gt;4&lt;/span&gt;" style="ellipse;html=1;fillColor=#ea580c;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1292" y="153" width="26" height="26" as="geometry"/></mxCell><mxCell id="c52" value="&lt;span style=&quot;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:18px;font-weight:800;color:#111827;&quot;&gt;평가&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1328" y="150" width="200" height="32" as="geometry"/></mxCell><mxCell id="c53" value="&lt;span style=&quot;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:12px;color:#4b5563;&quot;&gt;6일차&lt;/span&gt;" style="text;html=1;align=right;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1520" y="150" width="100" height="32" as="geometry"/></mxCell><mxCell id="c11" value="&lt;div style=&quot;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:30px;font-weight:800;color:#111827;letter-spacing:-0.5px;&quot;&gt;Action Recognition 모델 학습 파이프라인&lt;/div&gt;&lt;div style=&quot;margin-top:8px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:14px;color:#4b5563;&quot;&gt;원본 영상 18개 → Keypoint CSV → 사람 기준 분할 → Clip마다 1,140개 Feature → Random Forest 학습 → Validation · Test 평가&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="48" y="36" width="1200" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;div style=&quot;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:12px;color:#9ca3af;text-align:right;line-height:18px;&quot;&gt;교과10 자세추정 · 4~6일차 수업 코드 기준&lt;br&gt;&lt;span style=&quot;font-family:Consolas, D2Coding, monospace;&quot;&gt;subject10_pose_action/&lt;/span&gt; 경로&lt;/div&gt;" style="text;html=1;align=right;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1280" y="44" width="360" height="48" as="geometry"/></mxCell><mxCell id="c13" value="&lt;span style=&quot;display:inline-block;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:700;color:#374151;background:#e5e7eb;border-radius:4px;padding:2px 7px;&quot;&gt;입력 · 설정은 1·4일차에 만듦&lt;/span&gt;&lt;div style=&quot;margin-top:8px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:15px;font-weight:700;color:#111827;&quot;&gt;원본 영상 · 설정 파일&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:13px;line-height:19px;color:#4b5563;word-break:keep-all;&quot;&gt;3명(S01~S03) × 6동작 = 영상 18개, YOLO Pose 실행 설정, 동작 ID → 정답 이름 표&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:600;color:#9ca3af;&quot;&gt;경로&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#111827;padding-left:0;line-height:17px;&quot;&gt;data/day05/videos/S01~S03/*.mp4&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#111827;padding-left:0;line-height:17px;&quot;&gt;configs/project.json&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#111827;padding-left:0;line-height:17px;&quot;&gt;configs/action_classes.csv&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#f6f7f9;strokeColor=#e5e7eb;" vertex="1" parent="1"><mxGeometry x="68" y="220" width="328" height="200" as="geometry"/></mxCell><mxCell id="c14" value="&lt;span style=&quot;display:inline-block;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:700;color:#1d4ed8;background:#e0eaff;border-radius:4px;padding:2px 7px;&quot;&gt;5일차&lt;/span&gt;&lt;div style=&quot;margin-top:8px;font-family:Consolas, D2Coding, monospace;font-size:13.5px;font-weight:700;color:#111827;&quot;&gt;26_extract_keypoint_dataset.py&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:13px;line-height:19px;color:#4b5563;word-break:keep-all;&quot;&gt;Frame마다 YOLO Pose로 가장 확실한 사람 1명의 관절 17개 (x, y, conf)를 뽑고, 파일명의 A번호로 정답 action_label을 붙여 Clip별 CSV로 저장&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:600;color:#9ca3af;&quot;&gt;출력&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#4b5563;margin-top:3px;&quot;&gt;data/day05/keypoints/&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#111827;padding-left:12px;line-height:17px;&quot;&gt;S01~S03/{동작}/{clip}.csv · 18개&lt;/div&gt;&lt;div style=&quot;height:8px;&quot;&gt;&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#4b5563;margin-top:3px;&quot;&gt;data/day05/manifests/&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#111827;padding-left:12px;line-height:17px;&quot;&gt;keypoint_dataset_manifest.csv&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#ffffff;strokeColor=#d9dde3;shadow=0;" vertex="1" parent="1"><mxGeometry x="68" y="460" width="328" height="240" as="geometry"/></mxCell><mxCell id="c15" value="&lt;span style=&quot;display:inline-block;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:700;color:#1d4ed8;background:#e0eaff;border-radius:4px;padding:2px 7px;&quot;&gt;5일차&lt;/span&gt;&lt;div style=&quot;margin-top:8px;font-family:Consolas, D2Coding, monospace;font-size:13.5px;font-weight:700;color:#111827;&quot;&gt;29_build_approved_manifest.py&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:13px;line-height:19px;color:#4b5563;word-break:keep-all;&quot;&gt;사람이 검수한 표에서 PASS인 Clip만 골라 학습에 쓸 목록을 확정 (18개 모두 PASS)&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:600;color:#9ca3af;&quot;&gt;입력 · 27·28 QA 결과표&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#111827;padding-left:0;line-height:17px;&quot;&gt;data/day05/qa/keypoint_clip_review.csv&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:600;color:#9ca3af;&quot;&gt;출력&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#4b5563;margin-top:3px;&quot;&gt;data/day05/manifests/&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#111827;padding-left:12px;line-height:17px;&quot;&gt;approved_clip_manifest.csv&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#ffffff;strokeColor=#d9dde3;shadow=0;" vertex="1" parent="1"><mxGeometry x="68" y="756" width="328" height="224" as="geometry"/></mxCell><mxCell id="c16" value="&lt;span style=&quot;display:inline-block;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:700;color:#6b7280;background:#eef0f3;border-radius:4px;padding:2px 7px;&quot;&gt;설정&lt;/span&gt;&lt;div style=&quot;margin-top:8px;font-family:Consolas, D2Coding, monospace;font-size:13.5px;font-weight:700;color:#111827;&quot;&gt;configs/day05_subject_split.json&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:13px;line-height:19px;color:#4b5563;word-break:keep-all;&quot;&gt;S01 → train · S02 → val · S03 → test&lt;/div&gt;" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#fbfbfc;strokeColor=#c3c8d0;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="476" y="220" width="328" height="104" as="geometry"/></mxCell><mxCell id="c17" value="&lt;span style=&quot;display:inline-block;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:700;color:#1d4ed8;background:#e0eaff;border-radius:4px;padding:2px 7px;&quot;&gt;5일차&lt;/span&gt;&lt;div style=&quot;margin-top:8px;font-family:Consolas, D2Coding, monospace;font-size:13.5px;font-weight:700;color:#111827;&quot;&gt;30_build_subject_split.py&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:13px;line-height:19px;color:#4b5563;word-break:keep-all;&quot;&gt;승인된 18개 Clip을 사람(Subject) 단위로 나눔. 같은 사람이 train과 test에 함께 들어가지 않게 함&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:600;color:#9ca3af;&quot;&gt;출력&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#4b5563;margin-top:3px;&quot;&gt;data/day05/splits/&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#111827;padding-left:12px;line-height:17px;&quot;&gt;train.csv · val.csv · test.csv  (각 6 Clip)&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#ffffff;strokeColor=#d9dde3;shadow=0;" vertex="1" parent="1"><mxGeometry x="476" y="364" width="328" height="176" as="geometry"/></mxCell><mxCell id="c18" value="&lt;span style=&quot;display:inline-block;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:700;color:#b45309;background:#fdf0d5;border-radius:4px;padding:2px 7px;&quot;&gt;5일차 · 검사&lt;/span&gt;&lt;div style=&quot;margin-top:8px;font-family:Consolas, D2Coding, monospace;font-size:13.5px;font-weight:700;color:#111827;&quot;&gt;31_check_split_leakage.py&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:13px;line-height:19px;color:#4b5563;word-break:keep-all;&quot;&gt;split 사이에 사람·Clip이 겹치는지, 빠진 동작이 없는지 검사. 문제가 있으면 오류로 멈추고, 파일은 바꾸지 않음&lt;/div&gt;&lt;div style=&quot;margin-top:10px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:600;color:#9ca3af;&quot;&gt;결과&lt;/div&gt;&lt;div style=&quot;font-family:Consolas, D2Coding, monospace;font-size:11.5px;color:#111827;padding-left:0;line-height:17px;&quot;&gt;[PASS] 또는 [FAIL] 출력&lt;/div&gt;" style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#ffffff;strokeColor=#d9dde3;shadow=0;" vertex="1" parent="1"><mxGeometry x="476" y="580" width="328" height="160" as="geometry"/></mxCell><mxCell id="c19" value="&lt;span style=&quot;display:inline-block;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:700;color:#6b7280;background:#eef0f3;border-radius:4px;padding:2px 7px;&quot;&gt;설정&lt;/span&gt;&lt;div style=&quot;margin-top:8px;font-family:Consolas, D2Coding, monospace;font-size:13.5px;font-weight:700;color:#111827;&quot;&gt;configs/day06_baseline.json&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:13px;line-height:19px;color:#4b5563;word-break:keep-all;&quot;&gt;30 Step · 최소 10 Frame · Tree 300개 · seed 42&lt;/div&gt;" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#fbfbfc;strokeColor=#c3c8d0;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="884" y="220" width="328" height="104" as="geometry"/></mxCell><mxCell id="c20" value="&lt;span style=&quot;display:inline-block;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:700;color:#6b7280;background:#eef0f3;border-radius:4px;padding:2px 7px;&quot;&gt;공통 함수&lt;/span&gt;&lt;div style=&quot;margin-top:8px;font-family:Consolas, D2Coding, monospace;font-size:13.5px;font-weight:700;color:#111827;&quot;&gt;src/sequence_utils.py&lt;/div&gt;&lt;div style=&quot;margin-top:6px;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:13px;line-height:19px;color:#4b5563;word-break:keep-all;&quot;&gt;Frame마다 38개 값 계산(정규화는 feature_utils, 각도는 pose_utils 사용), 30 Step 선형 보간, 한 줄로 펼치기&lt;/div&gt;" style="rounded=1;arcSize=4;absoluteArcSize=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fillColor=#fbfbfc;strokeColor=#c3c8d0;dashed=1;dashPattern=4 3;" vertex="1" parent="1"><mxGeometry x="884" y="344" width="328" height="120" as="geometry"/></mxCell><mxCell id="c21" value="&lt;span style=&quot;display:inline-block;font-family:Pretendard Variable, Pretendard, Malgun Gothic, sans-serif;font-size:11px;font-weight:700;color:#15803d;background:#dcf3e5;border-radius:4px;padding:2px 7px;&q